# AI Forecast — Environment Configuration Example

# Frontend Environment Variables
# In development, points to local FastAPI. In production, points to cloud backend.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend Environment Variables
# Allowed CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration (SQLite for local development)
DATABASE_URL=sqlite:///./ai_forecast.db

# API Server Port (used in production environments like Render)
PORT=8000
